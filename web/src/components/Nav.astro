---
// Nav del sitio. La sección activa queda rodeada por una órbita punteada con un cohetito.
// Uso: <Nav active="home" />   (home | mission | data | about)
import { url } from '../lib/url';

const { active = 'home' } = Astro.props;

const items = [
  { id: 'home', label: 'Home', href: url('') },
  { id: 'mission', label: 'Signal lost', href: url('mission/'), logo: true },
  { id: 'data', label: 'Data', href: url('data/') },
  { id: 'about', label: 'About', href: url('about/') },
];
---

<header class="site-header">
  <nav class="nav container" aria-label="Main">
    <img class="nav-brand nav-patch" src={url('images/nav-patch.png')} alt="Signal lost mission patch" width="160" height="109" />
    <ul class="nav-list">
      {
        items.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={['nav-link', { 'is-active': item.id === active, 'has-logo': item.logo }]}
              aria-current={item.id === active ? 'page' : undefined}
            >
              {item.logo ? (
                <img class="nav-logo" src={url('images/logo-dark.png')} alt="Signal lost" width="600" height="250" />
              ) : (
                <span class="nav-label">{item.label}</span>
              )}
              <span class="orbit" aria-hidden="true">
                <svg viewBox="0 0 160 70" preserveAspectRatio="none">
                  <ellipse cx="80" cy="35" rx="76" ry="31" />
                </svg>
                <img class="orbit-rocket" src={url('images/rocket-nav.png')} alt="" width="170" height="200" />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    <img class="nav-brand nav-team" src={url('images/logo-2isi.png')} alt="2ISI team logo" width="160" height="160" />
  </nav>
  <svg class="hand-line" viewBox="0 0 1440 14" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 8 C 180 5, 380 10, 640 7 S 1060 4, 1260 8 S 1410 9, 1440 6" />
  </svg>
</header>

<style>
  .site-header {
    position: relative;
    background: var(--cream);
    z-index: 10;
  }

  .nav {
    padding: 18px 0 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(16px, 4vw, 56px);
  }

  /* Parche (izquierda) y logo 2ISI (derecha) */
  .nav-brand {
    flex: none;
    width: auto;
    height: 58px;
  }

  .nav-list {
    flex: 0 1 auto;
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 8px clamp(28px, 7vw, 96px);
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 56px;
    padding: 6px 18px;
    color: var(--ink);
    text-decoration: none;
    font-family: var(--font-hand);
    font-size: clamp(24px, 2.6vw, 32px);
    line-height: 1;
  }

  .nav-label {
    display: inline-block;
    transition: transform 0.2s ease;
  }

  .nav-link:hover .nav-label,
  .nav-link:hover .nav-logo {
    transform: rotate(-4deg) translateY(-2px);
  }

  .nav-logo {
    width: 104px;
    height: auto;
    transition: transform 0.2s ease;
  }

  /* Órbita punteada: solo visible en la sección activa (y un poquito al pasar el mouse) */
  .orbit {
    position: absolute;
    inset: -4px -10px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .orbit svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .orbit ellipse {
    fill: none;
    stroke: var(--orbit);
    stroke-width: 2.2;
    stroke-dasharray: 3 5;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .orbit-rocket {
    position: absolute;
    top: 5px;
    right: -14px;
    width: 50px;
    height: auto;
    transform: rotate(0deg);
  }

  .nav-link:hover .orbit {
    opacity: 0.35;
  }

  .nav-link.is-active .orbit {
    opacity: 1;
  }

  .nav-link.is-active .orbit-rocket {
    animation: rocket-bob 2.4s ease-in-out infinite;
  }

  @keyframes rocket-bob {
    0%,
    100% {
      transform: rotate(0deg) translate(0, 0);
    }
    50% {
      transform: rotate(4deg) translate(2px, -4px);
    }
  }

  .hand-line {
    display: block;
    width: 100%;
    height: 14px;
    margin-bottom: -7px;
  }

  .hand-line path {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2.2;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  @media (max-width: 560px) {
    .nav-brand {
      height: 34px;
    }
    .nav-list {
      gap: 4px 18px;
    }
    .nav-link {
      padding: 6px 12px;
    }
    .nav-logo {
      width: 84px;
    }
  }
</style>
