---
// HOME
import BaseLayout from '../layouts/BaseLayout.astro';
import Sky from '../components/Sky.astro';
import { url } from '../lib/url';

const stars = [
  { x: '22%', y: '7%', size: 40, kind: 'star', rot: -10, mobile: false },
  { x: '76%', y: '6%', size: 54, kind: 'star', rot: 8, mobile: false },
  { x: '24%', y: '42%', size: 34, kind: 'star', rot: -6, mobile: false },
  { x: '3%', y: '52%', size: 58, kind: 'sparkle', rot: 4 },
  { x: '94%', y: '40%', size: 40, kind: 'sparkle', rot: 12 },
  { x: '74%', y: '44%', size: 34, kind: 'star', rot: 6, mobile: false },
];

// Robots alrededor del Home (izquierda arriba, derecha arriba, izquierda abajo, derecha abajo)
const robotArt = [
  { name: 'Pragyan', src: 'images/robots/art-pragyan.webp', w: 520, h: 478, pos: 'pos-1' },
  { name: 'Curiosity', src: 'images/robots/art-curiosity.webp', w: 520, h: 460, pos: 'pos-2' },
  { name: 'Opportunity', src: 'images/robots/art-opportunity.webp', w: 520, h: 445, pos: 'pos-3' },
  { name: 'Phoenix', src: 'images/robots/art-phoenix.webp', w: 520, h: 281, pos: 'pos-4' },
];
---

<BaseLayout active="home" bg="home">
  <Sky stars={stars} />


  <section class="hero container">
    <h1 class="logo">
      <img src={url('images/logo-white.png')} alt="Signal lost" width="1200" height="500" fetchpriority="high" />
    </h1>

    <p class="tagline">The robots have gone silent. Can you bring them back?</p>

    <p class="intro">
      You are a young space specialist on a mission far from Earth. On the Moon and on Mars, our robot
      explorers have stopped talking. Your job: fix them, keep your base alive, and make every bit of
      energy count.
    </p>

    <p class="motto">&lt; Every choice matters, because up here, nothing is free. &gt;</p>

    <a class="btn-mission" href={url('mission/')}>Start Mission</a>
  </section>

  <div class="robot-ring">
    {
      robotArt.map((r) => (
        <img class:list={['robot-art', r.pos]} src={url(r.src)} alt={`${r.name}, drawn by our team`} width={r.w} height={r.h} loading="lazy" />
      ))
    }
  </div>

  <img class="astronaut" src={url('images/astronaut.webp')} alt="A smiling young astronaut in an orange suit, pointing up at the stars" width="1100" height="826" />
</BaseLayout>

<style>
  .hero {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
    padding-top: clamp(40px, 7vw, 80px);
    text-align: center;
    max-width: 760px;
  }

  .logo {
    width: min(100%, 560px);
  }

  .logo img {
    width: 100%;
    height: auto;
  }

  .tagline {
    font-family: var(--font-hand);
    font-size: clamp(26px, 3.2vw, 38px);
    line-height: 1.15;
    color: var(--white);
    text-shadow: 1px 0 0 var(--white);
  }

  .intro,
  .motto {
    font-family: var(--font-body);
    font-size: clamp(17px, 1.9vw, 20px);
    line-height: 1.6;
    color: #E8ECF4;
  }

  .motto {
    color: var(--white);
  }

  .btn-mission {
    margin-top: 14px;
  }

  /* --- Robots alrededor --- */
  .robot-ring {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .robot-art {
    position: absolute;
    height: auto;
    filter: drop-shadow(0 10px 18px rgba(0, 0, 0, 0.45));
    animation: drift 6s ease-in-out infinite;
  }

  /* Más pequeños y pegados al texto, como en el boceto */
  .pos-1 { left: max(4%, calc(50% - 560px)); top: 70px; width: clamp(100px, 9vw, 135px); --tilt: -6deg; }
  .pos-2 { right: max(4%, calc(50% - 560px)); top: 95px; width: clamp(100px, 9vw, 135px); --tilt: 5deg; animation-delay: -1.5s; }
  .pos-3 { left: max(4%, calc(50% - 570px)); top: 440px; width: clamp(105px, 9.5vw, 145px); --tilt: 4deg; animation-delay: -3s; }
  .pos-4 { right: max(4%, calc(50% - 570px)); top: 455px; width: clamp(120px, 11vw, 165px); --tilt: -4deg; animation-delay: -4.5s; }

  @keyframes drift {
    0%,
    100% {
      transform: translateY(0) rotate(var(--tilt));
    }
    50% {
      transform: translateY(-14px) rotate(calc(var(--tilt) * -0.5));
    }
  }

  /* En pantallas medianas y celular: los robots van en fila, debajo del botón */
  @media (max-width: 1150px) {
    .robot-ring {
      position: relative;
      inset: auto;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: flex-end;
      gap: 12px 24px;
      width: min(100% - 32px, 760px);
      margin: 40px auto 0;
    }

    .robot-art {
      position: static;
      width: clamp(80px, 18vw, 120px);
    }
  }

  .astronaut {
    position: relative;
    z-index: 1;
    width: min(96%, 780px);
    height: auto;
    margin: calc(-1 * min(19vw, 150px)) auto 0;
    pointer-events: none;
  }
</style>
