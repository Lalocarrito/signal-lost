---
// HOME
import BaseLayout from '../layouts/BaseLayout.astro';
import Sky from '../components/Sky.astro';
import { url } from '../lib/url';

const stars = [
  { x: '22%', y: '7%', size: 40, kind: 'star', rot: -10, mobile: false },
  { x: '76%', y: '6%', size: 54, kind: 'star', rot: 8, mobile: false },
  { x: '24%', y: '42%', size: 34, kind: 'star', rot: -6, mobile: false },
  { x: '3%', y: '52%', size: 58, kind: 'sparkle', rot: 4 },
  { x: '94%', y: '40%', size: 40, kind: 'sparkle', rot: 12 },
  { x: '74%', y: '44%', size: 34, kind: 'star', rot: 6, mobile: false },
];

// Robots alrededor del Home (izquierda arriba, derecha arriba, izquierda abajo, derecha abajo)
const robotArt = [
  { name: 'Pragyan', src: 'images/robots/art-pragyan.webp', w: 520, h: 478, pos: 'pos-1' },
  { name: 'Curiosity', src: 'images/robots/art-curiosity.webp', w: 520, h: 460, pos: 'pos-2' },
  { name: 'Opportunity', src: 'images/robots/art-opportunity.webp', w: 520, h: 445, pos: 'pos-3' },
  { name: 'Phoenix', src: 'images/robots/art-phoenix.webp', w: 520, h: 281, pos: 'pos-4' },
];

// Fotos del Arizona Science Center (se pueden arrastrar en compu)
// x / y / size son porcentajes dentro del tablero (compu); mx / my / msize, lo mismo en celular; rot es la inclinación.
const ascPhotos = [
  { src: 'images/asc/asc-final-demo.jpg', alt: 'Our team with the Signal Lost game running on four laptops', w: 900, h: 675, x: 3, y: 4, size: 36, rot: -5, mx: 3, my: 2, msize: 58 },
  { src: 'images/asc/asc-team-table.jpg', alt: 'The six of us working at the Mars station table', w: 900, h: 675, x: 60, y: 3, size: 36, rot: 4, mx: 40, my: 13, msize: 56 },
  { src: 'images/asc/asc-entrance.jpg', alt: 'The team in front of the Arizona Science Center entrance', w: 506, h: 900, x: 42, y: 3, size: 15, rot: -3, mx: 4, my: 59, msize: 27 },
  { src: 'images/asc/asc-sharing.jpg', alt: 'Sharing our drawing process with visitors', w: 900, h: 675, x: 10, y: 57, size: 35, rot: 3, mx: 30, my: 68, msize: 46 },
  { src: 'images/asc/asc-digital-world.jpg', alt: 'Two team members at the My Digital World exhibit', w: 675, h: 900, x: 62, y: 55, size: 18, rot: 6, mx: 70, my: 61, msize: 26 },
];
---

<BaseLayout active="home" bg="home">
  <Sky stars={stars} />


  <section class="hero container">
    <h1 class="logo">
      <img src={url('images/logo-white.png')} alt="Signal lost" width="1200" height="500" fetchpriority="high" />
    </h1>

    <p class="tagline">The robots have gone silent. Can you bring them back?</p>

    <p class="intro">
      You are a young space specialist on a mission far from Earth. On the Moon and on Mars, our robot
      explorers have stopped talking. Your job: fix them, keep your base alive, and make every bit of
      energy count.
    </p>

    <p class="motto">&lt; Every choice matters, because up here, nothing is free. &gt;</p>

    <a class="btn-mission" href={url('mission/')}>Start Mission</a>
  </section>

  <div class="robot-ring">
    {
      robotArt.map((r) => (
        <img class:list={['robot-art', r.pos]} src={url(r.src)} alt={`${r.name}, drawn by our team`} width={r.w} height={r.h} loading="lazy" />
      ))
    }
  </div>

  <img class="astronaut" src={url('images/astronaut.webp')} alt="A smiling young astronaut in an orange suit, pointing up at the stars" width="1100" height="826" />

  <!-- Arizona Science Center -->
  <section class="asc container" aria-labelledby="asc-title">
    <p class="kicker">— field log · Phoenix, Arizona —</p>
    <h2 id="asc-title" class="section-title">Arizona Science Center</h2>
    <p class="asc-text">
      We were the lucky team that got to spend the challenge at the Arizona Science Center. There we developed our
      idea for this challenge and shared our process with the community: we answered visitors' questions and invited
      kids to join science competitions, hoping to inspire them to step into these fields.
    </p>
    <p class="asc-hint">Drag the photos around!</p>

    <div class="photo-board" data-board>
      <p class="board-quote">If you can dream it, you can build it!</p>
      {
        ascPhotos.map((ph, i) => (
          <figure
            class="polaroid"
            style={`--x:${ph.x}%; --y:${ph.y}%; --size:${ph.size}%; --mx:${ph.mx}%; --my:${ph.my}%; --msize:${ph.msize}%; --rot:${ph.rot}deg; z-index:${i + 1};`}
            data-drag
          >
            <img src={url(ph.src)} alt={ph.alt} width={ph.w} height={ph.h} loading="lazy" draggable="false" />
          </figure>
        ))
      }
    </div>
  </section>
</BaseLayout>

<script>
  // Arrastrar las fotos dentro del tablero (mouse, lápiz o dedo).
  const board = document.querySelector('[data-board]');
  let top = 10;

  if (board) {
    board.querySelectorAll('[data-drag]').forEach((card) => {
      card.addEventListener('pointerdown', (e) => {
        e.preventDefault();
        const b = board.getBoundingClientRect();
        const c = card.getBoundingClientRect();
        const offX = e.clientX - c.left;
        const offY = e.clientY - c.top;
        top += 1;
        card.style.zIndex = String(top);
        card.classList.add('is-dragging');
        card.setPointerCapture(e.pointerId);

        const move = (ev) => {
          const x = Math.min(Math.max(ev.clientX - b.left - offX, 0), b.width - c.width);
          const y = Math.min(Math.max(ev.clientY - b.top - offY, 0), b.height - c.height);
          card.style.left = `${(x / b.width) * 100}%`;
          card.style.top = `${(y / b.height) * 100}%`;
        };
        const up = () => {
          card.classList.remove('is-dragging');
          card.removeEventListener('pointermove', move);
          card.removeEventListener('pointerup', up);
          card.removeEventListener('pointercancel', up);
        };
        card.addEventListener('pointermove', move);
        card.addEventListener('pointerup', up);
        card.addEventListener('pointercancel', up);
      });
    });
  }
</script>

<style>
  .hero {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
    padding-top: clamp(40px, 7vw, 80px);
    text-align: center;
    max-width: 760px;
  }

  .logo {
    width: min(100%, 560px);
  }

  .logo img {
    width: 100%;
    height: auto;
  }

  .tagline {
    font-family: var(--font-hand);
    font-size: clamp(26px, 3.2vw, 38px);
    line-height: 1.15;
    color: var(--white);
    text-shadow: 1px 0 0 var(--white);
  }

  .intro,
  .motto {
    font-family: var(--font-body);
    font-size: clamp(17px, 1.9vw, 20px);
    line-height: 1.6;
    color: #E8ECF4;
  }

  .motto {
    color: var(--white);
  }

  .btn-mission {
    margin-top: 14px;
  }

  /* --- Robots alrededor --- */
  .robot-ring {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .robot-art {
    position: absolute;
    height: auto;
    filter: drop-shadow(0 10px 18px rgba(0, 0, 0, 0.45));
    animation: drift 6s ease-in-out infinite;
  }

  /* Más pequeños y pegados al texto, como en el boceto */
  .pos-1 { left: max(4%, calc(50% - 560px)); top: 70px; width: clamp(100px, 9vw, 135px); --tilt: -6deg; }
  .pos-2 { right: max(4%, calc(50% - 560px)); top: 95px; width: clamp(100px, 9vw, 135px); --tilt: 5deg; animation-delay: -1.5s; }
  .pos-3 { left: max(4%, calc(50% - 570px)); top: 440px; width: clamp(105px, 9.5vw, 145px); --tilt: 4deg; animation-delay: -3s; }
  .pos-4 { right: max(4%, calc(50% - 570px)); top: 455px; width: clamp(120px, 11vw, 165px); --tilt: -4deg; animation-delay: -4.5s; }

  @keyframes drift {
    0%,
    100% {
      transform: translateY(0) rotate(var(--tilt));
    }
    50% {
      transform: translateY(-14px) rotate(calc(var(--tilt) * -0.5));
    }
  }

  /* En pantallas medianas y celular: los robots van en fila, debajo del botón */
  @media (max-width: 1150px) {
    .robot-ring {
      position: relative;
      inset: auto;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: flex-end;
      gap: 12px 24px;
      width: min(100% - 32px, 760px);
      margin: 40px auto 0;
    }

    .robot-art {
      position: static;
      width: clamp(80px, 18vw, 120px);
    }
  }

  /* ---------- Arizona Science Center ---------- */
  .asc {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding: clamp(50px, 7vw, 90px) 0 clamp(60px, 8vw, 100px);
    text-align: center;
  }

  .asc .section-title {
    margin: 0;
  }

  .asc-text {
    max-width: 760px;
    font-size: clamp(18px, 2vw, 22px);
    line-height: 1.55;
    color: var(--white);
  }

  .asc-hint {
    font-family: var(--font-hand);
    font-size: 20px;
    color: var(--orange);
    transform: rotate(-2deg);
  }

  /* Tablero de papel con las fotos encimadas */
  .photo-board {
    position: relative;
    width: 100%;
    max-width: 1000px;
    aspect-ratio: 16 / 12;
    margin-top: 8px;
    background: var(--cream);
    border: 2.5px solid var(--ink);
    border-radius: var(--wobbly-1);
    box-shadow: 6px 8px 0 rgba(0, 0, 0, 0.35);
    overflow: hidden;
  }

  /* Frase escrita en el tablero (queda detrás de las fotos) */
  .board-quote {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 0;
    width: 90%;
    margin: 0;
    font-family: var(--font-hand);
    font-size: clamp(30px, 4.4vw, 52px);
    line-height: 1.1;
    color: var(--orange);
    text-align: center;
    transform: translate(-50%, -50%) rotate(-4deg);
    pointer-events: none;
  }

  /* Foto estilo polaroid */
  .polaroid {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--size);
    margin: 0;
    padding: 8px 8px 22px;
    background: #fff;
    border-radius: 4px;
    box-shadow: 0 6px 14px rgba(31, 41, 51, 0.35);
    transform: rotate(var(--rot));
    cursor: grab;
    touch-action: none;
    user-select: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .polaroid:hover {
    transform: rotate(var(--rot)) scale(1.03);
  }

  .polaroid.is-dragging {
    cursor: grabbing;
    transform: rotate(0deg) scale(1.06);
    box-shadow: 0 14px 28px rgba(31, 41, 51, 0.45);
    transition: none;
  }

  .polaroid img {
    display: block;
    width: 100%;
    height: auto;
    pointer-events: none;
  }

  /* En celular: el mismo collage, pero con otras posiciones (mx / my / msize) */
  @media (max-width: 760px) {
    .asc-text {
      padding: 0 6px;
    }

    .asc-hint {
      font-size: 18px;
    }

    .photo-board {
      aspect-ratio: 3 / 4.4;
    }

    .polaroid {
      left: var(--mx);
      top: var(--my);
      width: var(--msize);
      padding: 5px 5px 14px;
    }

    .board-quote {
      top: 50%;
      font-size: clamp(22px, 7vw, 30px);
    }
  }

  .astronaut {
    position: relative;
    z-index: 1;
    width: min(96%, 780px);
    height: auto;
    margin: calc(-1 * min(19vw, 150px)) auto 0;
    pointer-events: none;
  }
</style>
